# WeGov front-end environment
#
# Content comes from the Sarapis Payload CMS (multi-brand). Both vars below are
# OPTIONAL — src/lib/api.js defaults to exactly these values — so an unset
# environment still points at the right place.
NEXT_PUBLIC_PAYLOAD_URL=https://next.sarapis.org
NEXT_PUBLIC_SITE_KEY=wegovnyc

# Preview/draft secret (unchanged)
# PREVIEW_SECRET=...
